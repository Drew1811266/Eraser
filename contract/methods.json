{
  "contractVersion": "1.0.0",
  "rpc": {
    "jsonrpc": "2.0",
    "framing": "newline-delimited-json",
    "encoding": "utf-8",
    "notes": [
      "stdout carries protocol frames only; all logging must go to stderr.",
      "Long-running methods return a task_id immediately and stream progress notifications.",
      "Notifications have no id and must be ignored by response matchers."
    ]
  },
  "types": {
    "Rect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "VideoMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "frame_count": {
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "frame_count"
      ]
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "start_frame": {
          "type": "integer"
        },
        "end_frame": {
          "type": "integer"
        },
        "rect": {
          "$ref": "#/types/Rect"
        },
        "expand_px": {
          "type": "integer"
        },
        "feather_px": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "rect"
      ]
    },
    "MediaInfo": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "type": "number"
        },
        "frame_count": {
          "type": "integer"
        },
        "duration_seconds": {
          "type": "number"
        },
        "has_audio": {
          "type": "boolean"
        },
        "video_codec": {
          "type": "string"
        },
        "container": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "width",
        "height",
        "fps",
        "frame_count",
        "has_audio"
      ]
    },
    "TaskStatus": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        },
        "processed": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "eta_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "state",
        "phase",
        "progress"
      ]
    },
    "ModelEntry": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "installed": {
          "type": "boolean"
        },
        "implemented": {
          "type": "boolean"
        },
        "blocked_reason": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "display_name",
        "engine",
        "installed",
        "implemented"
      ]
    },
    "DeviceInfo": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "memory_mb": {
          "type": "number"
        },
        "provider": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/types/DeviceInfo"
          }
        },
        "runtime": {
          "$ref": "#/types/RuntimeInfo"
        }
      },
      "required": [
        "engine_version",
        "python_version",
        "platform",
        "methods",
        "devices",
        "runtime"
      ]
    },
    "RuntimeInfo": {
      "type": "object",
      "properties": {
        "available_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cuda_usable": {
          "type": "boolean"
        },
        "onnxruntime": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available_providers",
        "cuda_usable",
        "onnxruntime"
      ]
    }
  },
  "methods": [
    {
      "name": "system.ping",
      "summary": "Liveness check. The shell uses this to confirm the engine is responsive.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "properties": {
          "pong": {
            "type": "boolean"
          },
          "uptime_ms": {
            "type": "number"
          },
          "engine_version": {
            "type": "string"
          }
        },
        "required": [
          "pong",
          "uptime_ms",
          "engine_version"
        ]
      }
    },
    {
      "name": "system.capabilities",
      "summary": "Report platform, devices and the live method surface.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "$ref": "#/types/Capabilities"
      }
    },
    {
      "name": "system.shutdown",
      "summary": "Ask the engine to exit cleanly. The shell calls this before quit.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      }
    },
    {
      "name": "media.probe",
      "summary": "Read video metadata via ffprobe.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "result": {
        "$ref": "#/types/MediaInfo"
      }
    },
    {
      "name": "annotation.normalize",
      "summary": "Clamp, order and default-fill annotation segments against video geometry.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/types/Segment"
            }
          },
          "video": {
            "$ref": "#/types/VideoMeta"
          }
        },
        "required": [
          "segments",
          "video"
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/types/Segment"
            }
          }
        },
        "required": [
          "segments"
        ]
      }
    },
    {
      "name": "process.start",
      "summary": "Start a watermark-removal run. Returns a task id immediately.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input_path": {
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/types/Segment"
            }
          }
        },
        "required": [
          "input_path",
          "segments"
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      }
    },
    {
      "name": "process.cancel",
      "summary": "Request cooperative cancellation of a running task.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      }
    },
    {
      "name": "process.status",
      "summary": "Snapshot a processing task.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "result": {
        "$ref": "#/types/TaskStatus"
      }
    },
    {
      "name": "upscale.start",
      "summary": "Upscale a video 2x or 4x with Real-ESRGAN. Returns a task id; progress is streamed and the task is inspected through process.status / process.cancel.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input_path": {
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          },
          "scale": {
            "type": "integer"
          },
          "model_id": {
            "type": "string"
          }
        },
        "required": [
          "input_path"
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      }
    },
    {
      "name": "model.list",
      "summary": "List known models and their install state.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/types/ModelEntry"
            }
          }
        },
        "required": [
          "models"
        ]
      }
    },
    {
      "name": "model.install",
      "summary": "Download and verify a model. Returns a task id immediately.",
      "implemented": false,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model_id": {
            "type": "string"
          },
          "force": {
            "type": "boolean"
          }
        },
        "required": [
          "model_id"
        ]
      },
      "result": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      }
    },
    {
      "name": "model.installStatus",
      "summary": "Snapshot a model-install task.",
      "implemented": false,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "result": {
        "$ref": "#/types/TaskStatus"
      }
    },
    {
      "name": "assets.verify",
      "summary": "Check that required runtime assets (ffmpeg, models) are present.",
      "implemented": true,
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "missing"
        ]
      }
    }
  ]
}
