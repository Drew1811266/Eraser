# ---- Reference snapshot (local only) ----
.reference/
.reference-*/

# ---- Node / Electron ----
node_modules/
desktop/node_modules/
desktop/dist/
desktop/dist-renderer/
desktop/dist-electron/
desktop/release/
desktop/.functional-test/
*.tsbuildinfo
.npm/
.pnpm-store/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
engine/build/
engine/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Build outputs ----
build/
dist/
out/
*.spec
!packaging/*.spec
*.exe
*.msi
*.nupkg

# ---- Assets (never in git; distributed separately) ----
assets/ffmpeg/
assets/models/
vendor/
models/
*.onnx
*.gguf
*.pth
*.pt
*.safetensors
*.bin

# ---- Golden samples (use LFS or external storage) ----
golden/cases/**/*.mp4
golden/cases/**/*.mkv
golden/cases/**/*.webm

# ---- Local state ----
logs/
*.log
.omx/
.trae/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.config.local.*

# downloaded assets and test scratch space
.cache/

# ---- Scratch that must never be committed ----
# `tempfile.gettempdir()` can resolve to the working directory when the system
# temp is unwritable (see engine/platform/paths.py), so these are guarded here
# as well as in code.
/eraser/
/seedvr-driver-*/
/seedvr-task-*/
/seedvr-out-*/
/pip-build-tracker-*/
/preview-*/
/tmp*/
/pip-unpack-*/
/pip-metadata-*/
/CON

# ---- AI coding scratch (ledger, briefs) ----
.superpowers/
