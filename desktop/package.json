{
  "name": "eraser-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Eraser desktop shell: Electron main process + React renderer.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "dev:renderer": "vite",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.5",
    "@material/web": "^2.4.1",
    "material-symbols": "^0.44.5",
    "zustand": "^4.5.5",
    "dayjs": "^1.11.13"
  },
  "build": {
    "appId": "com.eraser.desktop",
    "productName": "Eraser",
    "directories": {
      "output": "../dist/installer",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../dist/Eraser/engine",
        "to": "engine"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Eraser-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eraser",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
